{
  "name": "cirquimia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && storybook build -c .storybook -o dist/components --quiet --disable-telemetry",
    "build:single": "npm run build && node scripts/inline.mjs",
    "build:itch": "tsc --noEmit && vite build --mode itch --outDir dist-itch && node scripts/itch.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@types/three": "^0.186.0",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
